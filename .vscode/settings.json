{
  "[js,ts]": {
    "editor.tabSize": 2
  },
  "[rust,php]": {
    "editor.tabSize": 4
  },
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
  },
  "eslint.useFlatConfig": true,
  "emeraldwalk.runonsave": {
    "commands": [
      {
        "cmd": "pnpm lint:php",
        "match": "\\.php$"
      }
    ]
  },
}